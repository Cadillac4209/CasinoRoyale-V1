rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 30 &&
             data.totalXp is int &&
             data.totalXp >= 0 &&
             data.totalXp <= 1000000000 &&
             data.level is int &&
             data.level >= 1 &&
             data.level <= 500 &&
             data.vipTitle is string &&
             data.vipTitle.size() >= 1 &&
             data.vipTitle.size() <= 40 &&
             data.bestWinStreak is int &&
             data.bestWinStreak >= 0 &&
             data.bestWinStreak <= 1000000 &&
             data.biggestWin is int &&
             data.biggestWin >= 0 &&
             data.biggestWin <= 10000000000 &&
             data.totalRoundsPlayed is int &&
             data.totalRoundsPlayed >= 0 &&
             data.totalRoundsPlayed <= 1000000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /leaderboard/{userId} {
      // Signed-in users can read the global leaderboard (no PII is stored in this collection)
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId',
                         'displayName',
                         'totalXp',
                         'level',
                         'vipTitle',
                         'bestWinStreak',
                         'biggestWin',
                         'totalRoundsPlayed',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'displayName',
                         'totalXp',
                         'level',
                         'vipTitle',
                         'bestWinStreak',
                         'biggestWin',
                         'totalRoundsPlayed',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'totalXp',
                         'level',
                         'vipTitle',
                         'bestWinStreak',
                         'biggestWin',
                         'totalRoundsPlayed',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;
    }
  }
}
