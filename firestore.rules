rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 30 &&
             data.totalXp is int &&
             data.totalXp >= 0 &&
             data.totalXp <= 1000000000 &&
             data.level is int &&
             data.level >= 1 &&
             data.level <= 500 &&
             data.vipTitle is string &&
             data.vipTitle.size() >= 1 &&
             data.vipTitle.size() <= 40 &&
             data.bestWinStreak is int &&
             data.bestWinStreak >= 0 &&
             data.bestWinStreak <= 1000000 &&
             data.biggestWin is int &&
             data.biggestWin >= 0 &&
             data.biggestWin <= 10000000000 &&
             data.totalRoundsPlayed is int &&
             data.totalRoundsPlayed >= 0 &&
             data.totalRoundsPlayed <= 1000000000 &&
             data.royalePoints is int &&
             data.royalePoints >= 0 &&
             data.royalePoints <= 1000000000 &&
             data.lifetimeRoyalePoints is int &&
             data.lifetimeRoyalePoints >= 0 &&
             data.lifetimeRoyalePoints <= 1000000000 &&
             data.loyaltyTier is string &&
             data.loyaltyTier.size() >= 1 &&
             data.loyaltyTier.size() <= 40 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidDailyLoginRecord(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.currentStreak is int &&
             data.currentStreak >= 0 &&
             data.currentStreak <= 10000 &&
             data.bestStreak is int &&
             data.bestStreak >= 0 &&
             data.bestStreak <= 10000 &&
             data.totalCheckIns is int &&
             data.totalCheckIns >= 0 &&
             data.totalCheckIns <= 100000 &&
             data.lastClaimedChips is int &&
             data.lastClaimedChips >= 0 &&
             data.lastClaimedChips <= 10000000 &&
             data.lastLoginAt is timestamp &&
             data.lastLoginAt <= request.time &&
             (!('lastBonusClaimAt' in data) || (data.lastBonusClaimAt is timestamp && data.lastBonusClaimAt <= request.time)) &&
             (!('lastWheelSpinAt' in data) || (data.lastWheelSpinAt is timestamp && data.lastWheelSpinAt <= request.time)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /leaderboard/{userId} {
      // Signed-in users can read the global leaderboard (no PII is stored in this collection)
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId',
                         'displayName',
                         'totalXp',
                         'level',
                         'vipTitle',
                         'bestWinStreak',
                         'biggestWin',
                         'totalRoundsPlayed',
                         'royalePoints',
                         'lifetimeRoyalePoints',
                         'loyaltyTier',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'displayName',
                         'totalXp',
                         'level',
                         'vipTitle',
                         'bestWinStreak',
                         'biggestWin',
                         'totalRoundsPlayed',
                         'royalePoints',
                         'lifetimeRoyalePoints',
                         'loyaltyTier',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'totalXp',
                         'level',
                         'vipTitle',
                         'bestWinStreak',
                         'biggestWin',
                         'totalRoundsPlayed',
                         'royalePoints',
                         'lifetimeRoyalePoints',
                         'loyaltyTier',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;
    }

    match /dailyLogins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId',
                         'currentStreak',
                         'bestStreak',
                         'totalCheckIns',
                         'lastClaimedChips',
                         'lastLoginAt',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'currentStreak',
                         'bestStreak',
                         'totalCheckIns',
                         'lastClaimedChips',
                         'lastLoginAt',
                         'lastBonusClaimAt',
                         'lastWheelSpinAt',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidDailyLoginRecord(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidDailyLoginRecord(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'currentStreak',
                         'bestStreak',
                         'totalCheckIns',
                         'lastClaimedChips',
                         'lastLoginAt',
                         'lastBonusClaimAt',
                         'lastWheelSpinAt',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;
    }
  }
}
